<package>
  <name>assignment2</name>
  <version>0.0.1</version>
  <description>
    ArUco-based localisation on the Duckiebot.
    Detects ArUco markers, estimates robot pose, falls back to wheel odometry,
    and publishes a live camera + top-down map visualisation.
  </description>
  <maintainer email="egemen06292@gmail.com">Egemen Kozanli</maintainer>
  <license>None</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- ROS runtime dependencies -->
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf</depend>

  <!-- Duckietown-specific messages -->
  <depend>duckietown_msgs</depend>

  <!-- Python system packages -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
