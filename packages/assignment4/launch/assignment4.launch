<launch>
  <arg name="veh" default="$(env VEHICLE_NAME)"/>
  <arg name="config" default="$(find assignment4)/config/params.yaml"/>

  <node name="assignment4_node"
        pkg="assignment4"
        type="assignment4.py"
        output="screen"
        required="true">
    <param name="config_path" value="$(arg config)"/>
    <param name="vehicle_name" value="$(arg veh)"/>
  </node>
</launch>
